{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hey Get API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Get",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /v1/get/{organization_slug}/{project_slug}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/get/:organization_slug/:project_slug",
            "params": [
              {
                "name": "organization_slug",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_slug",
                "value": "",
                "type": "path"
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query"
              },
              {
                "name": "branch",
                "value": "",
                "type": "query"
              },
              {
                "name": "commit_sha",
                "value": "",
                "type": "query"
              },
              {
                "name": "inline",
                "value": "",
                "type": "query"
              },
              {
                "name": "latest",
                "value": "",
                "type": "query"
              },
              {
                "name": "tags",
                "value": "",
                "type": "query"
              },
              {
                "name": "version",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}